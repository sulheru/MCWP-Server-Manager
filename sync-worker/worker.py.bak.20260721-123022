import json
import os
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

import mysql.connector


VERSION = "0.4.0"

DB_HOST = os.getenv("DB_HOST", "db")
DB_PORT = int(os.getenv("DB_PORT", "3306"))
DB_NAME = os.getenv("DB_NAME", "wordpress_and_mc")
DB_USER = os.getenv("DB_USER", "wordpress")
DB_PASSWORD = os.getenv("DB_PASSWORD", "")

GATEWAY_URL = os.getenv(
    "GATEWAY_URL",
    "http://minecraft-gateway:8000",
).rstrip("/")

POLL_SECONDS = max(5, int(os.getenv("POLL_SECONDS", "10")))
DRY_RUN = os.getenv("DRY_RUN", "true").lower() == "true"
HTTP_TIMEOUT = float(os.getenv("HTTP_TIMEOUT", "8"))

ALLOWED_PLAYER_GAMEMODES = {
    "survival",
    "creative",
    "adventure",
    "spectator",
}

ALLOWED_DIFFICULTIES = {
    "peaceful",
    "easy",
    "normal",
    "hard",
}

ALLOWED_DEFAULT_GAMEMODES = {
    "survival",
    "creative",
    "adventure",
    "spectator",
}

TELEMETRY_DIR = Path(
    os.getenv("TELEMETRY_DIR", "/app/telemetry")
)
HEARTBEAT_FILE = TELEMETRY_DIR / "worker-heartbeat.json"


def log(message):
    print(f"[mc-sync-worker] {message}", flush=True)


def clean_message(value, maximum=1000):
    text = str(value).replace("\x00", "").strip()
    return text[:maximum]


def write_heartbeat(
    status,
    rows_count=None,
    error=None,
    server_settings_rows=None,
):
    TELEMETRY_DIR.mkdir(parents=True, exist_ok=True)

    payload = {
        "timestamp": time.time(),
        "status": status,
        "version": VERSION,
        "poll_seconds": POLL_SECONDS,
        "dry_run": DRY_RUN,
        "rows": rows_count,
        "server_settings_rows": server_settings_rows,
        "error": error,
        "updated_at": datetime.now(timezone.utc).isoformat(),
    }

    tmp = HEARTBEAT_FILE.with_suffix(".tmp")
    tmp.write_text(
        json.dumps(payload, ensure_ascii=False, indent=2),
        encoding="utf-8",
    )
    tmp.replace(HEARTBEAT_FILE)


def db_connect():
    return mysql.connector.connect(
        host=DB_HOST,
        port=DB_PORT,
        database=DB_NAME,
        user=DB_USER,
        password=DB_PASSWORD,
        autocommit=False,
        charset="utf8mb4",
        use_unicode=True,
    )


