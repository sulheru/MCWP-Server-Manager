def user_rows():
    connection = db_connect()

    try:
        cursor = connection.cursor(dictionary=True)
        cursor.execute(
            """
            SELECT
                a.user_id,
                a.minecraft_username,
                a.is_active,
                a.gamemode,
                a.is_blacklisted,
                a.banned_until,
                u.user_login
            FROM wp_solidario_mc_access a
            JOIN wp_users u
              ON u.ID = a.user_id
            WHERE a.minecraft_username IS NOT NULL
              AND a.minecraft_username <> ''
            ORDER BY a.user_id
            """
        )
        return cursor.fetchall()
    finally:
        connection.close()


def update_user_telemetry(uid, ws, wm, bs, bm):
    connection = db_connect()

    try:
        cursor = connection.cursor()
        cursor.execute(
            """
            UPDATE wp_solidario_mc_access
            SET
                whitelist_status = %s,
                whitelist_message = %s,
                whitelist_updated_at = NOW(),
                ban_status = %s,
                ban_message = %s,
                ban_updated_at = NOW()
            WHERE user_id = %s
            """,
            (ws, wm, bs, bm, uid),
        )
        connection.commit()
    finally:
        connection.close()


def gateway_request(method, path, payload=None):
    body = None
    headers = {
        "Accept": "application/json",
    }

    if payload is not None:
        body = json.dumps(payload).encode("utf-8")
        headers["Content-Type"] = "application/json"

    request = urllib.request.Request(
        GATEWAY_URL + path,
        data=body,
        headers=headers,
        method=method,
    )

    try:
        with urllib.request.urlopen(
            request,
            timeout=HTTP_TIMEOUT,
        ) as response:
            raw = response.read().decode("utf-8", errors="replace")
            return json.loads(raw) if raw else {}

    except urllib.error.HTTPError as exc:
        response_body = exc.read().decode(
            "utf-8",
            errors="replace",
        )
        raise RuntimeError(
            f"Gateway HTTP {exc.code}: {response_body}"
        ) from exc

    except urllib.error.URLError as exc:
        raise RuntimeError(
            f"Gateway no disponible: {exc.reason}"
        ) from exc

    except TimeoutError as exc:
        raise RuntimeError(
            f"Gateway timeout después de {HTTP_TIMEOUT}s"
        ) from exc

    except json.JSONDecodeError as exc:
        raise RuntimeError(
            "Gateway devolvió JSON inválido"
        ) from exc


def exists(path):
    return bool(gateway_request("GET", path).get("exists"))


def action(path, payload):
    if DRY_RUN:
        return {"result": f"dry-run {path}"}

    return gateway_request("POST", path, payload)


def future(value):
    if not value:
        return False

    if isinstance(value, datetime):
        date_value = value
    else:
        date_value = datetime.fromisoformat(
            str(value).replace("Z", "+00:00")
        )

    if date_value.tzinfo is None:
        date_value = date_value.replace(tzinfo=timezone.utc)

    return (
        date_value.astimezone(timezone.utc)
        > datetime.now(timezone.utc)
    )


def reconcile_user(row):
    uid = int(row["user_id"])
    name = row["minecraft_username"]

    active = bool(row["is_active"])
    blacklisted = bool(row["is_blacklisted"])
    temporarily_banned = future(row["banned_until"])

    banned = blacklisted or temporarily_banned
    wanted_whitelist = active and not banned

    banned_now = exists(f"/player/ban/exists/{name}")
    whitelist_now = exists(f"/whitelist/exists/{name}")

    ban_messages = []
    whitelist_messages = []

    if banned:
        if not banned_now:
            if blacklisted:
                reason = "Blacklist administrativa"
            else:
                reason = (
                    "Baneo temporal hasta "
                    f"{row['banned_until']}"
                )

            result = action(
                "/player/ban",
                {
                    "username": name,
                    "reason": reason,
                },
            ).get("result")

            ban_messages.append(f"ban: {result}")
        else:
            ban_messages.append("ban: ya aplicado")

        if whitelist_now:
            result = action(
                "/whitelist/remove",
                {"username": name},
            ).get("result")
            whitelist_messages.append(f"remove: {result}")
        else:
            whitelist_messages.append(
                "whitelist: ya ausente"
            )

        if DRY_RUN:
            ban_status = "dry_run"
            whitelist_status = "dry_run"
        else:
            ban_status = (
                "blacklisted"
                if blacklisted
                else "temporary"
            )
            whitelist_status = "absent"

    else:
        if banned_now:
            result = action(
                "/player/pardon",
                {"username": name},
            ).get("result")
            ban_messages.append(f"pardon: {result}")
        else:
            ban_messages.append("ban: ausente")

        if wanted_whitelist and not whitelist_now:
            result = action(
                "/whitelist/add",
                {"username": name},
            ).get("result")
            whitelist_messages.append(f"add: {result}")

        elif not wanted_whitelist and whitelist_now:
            result = action(
                "/whitelist/remove",
                {"username": name},
            ).get("result")
            whitelist_messages.append(f"remove: {result}")

        else:
            whitelist_messages.append(
                "whitelist: estado correcto"
            )

        if DRY_RUN:
            ban_status = "dry_run"
            whitelist_status = "dry_run"
        else:
            ban_status = "none"
            whitelist_status = (
                "present"
                if wanted_whitelist
                else "absent"
            )

    mode = row["gamemode"]

    if mode not in ALLOWED_PLAYER_GAMEMODES:
        mode = "survival"

    if active and not banned:
        result = action(
            "/player/gamemode",
            {
                "username": name,
                "gamemode": mode,
            },
        ).get("result")

        whitelist_messages.append(
            f"gamemode: {result}"
        )

    update_user_telemetry(
        uid,
        whitelist_status,
        " | ".join(whitelist_messages),
        ban_status,
        " | ".join(ban_messages),
    )

    log(
        f"user_id={uid} "
        f"wp={row['user_login']} "
        f"mc={name} "
        f"blacklist={int(blacklisted)} "
        f"temporary={int(temporarily_banned)} "
        f"active={int(active)} "
        f"desired_banned={int(banned)} "
        f"desired_whitelist={int(wanted_whitelist)} "
        f"dry_run={DRY_RUN}"
    )


def reconcile_users_once():
    rows = user_rows()
    errors = []

    log(
        f"version={VERSION} "
        f"users={len(rows)} "
        f"dry_run={DRY_RUN} "
        f"gateway={GATEWAY_URL}"
    )

    for row in rows:
        try:
            reconcile_user(row)

        except Exception as exc:
            message = clean_message(exc)
            errors.append(
                f"user_id={row['user_id']}: {message}"
            )

            log(
                f"user_id={row['user_id']} "
                f"error={message}"
            )

            try:
                update_user_telemetry(
                    int(row["user_id"]),
                    "error",
                    message,
                    "error",
                    message,
                )
            except Exception as telemetry_error:
                log(
                    "telemetry_error="
                    f"{clean_message(telemetry_error)}"
                )

    return len(rows), errors


