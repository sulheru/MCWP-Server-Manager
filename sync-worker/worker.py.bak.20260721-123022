        connection.commit()
    finally:
        connection.close()


def normalize_setting_value(value):
    if value is None:
        return ""

    return str(value).strip().lower()


def find_key_recursive(value, wanted_key):
    if isinstance(value, dict):
        for key, child in value.items():
            if str(key).lower() == wanted_key.lower():
                return child

        for child in value.values():
            result = find_key_recursive(
                child,
                wanted_key,
            )
            if result is not None:
                return result

    elif isinstance(value, list):
        for child in value:
            result = find_key_recursive(
                child,
                wanted_key,
            )
            if result is not None:
                return result

    return None


def apply_difficulty(desired_value):
    if desired_value not in ALLOWED_DIFFICULTIES:
        raise ValueError(
            "difficulty no permitida: "
            f"{desired_value!r}"
        )

    gateway_request(
        "POST",
        "/server/difficulty",
        {"value": desired_value},
    )

    observed_state = gateway_request(
        "GET",
        "/server",
    )

    observed_value = find_key_recursive(
        observed_state,
        "difficulty",
    )

    if observed_value is None:
        raise RuntimeError(
            "difficulty aplicada, pero GET /server "
            "no devolvió el campo difficulty"
        )

    observed_value = normalize_setting_value(
        observed_value
    )

    if observed_value != desired_value:
        raise RuntimeError(
            "difficulty aplicada, pero GET /server "
            f"observó {observed_value!r} en vez de "
            f"{desired_value!r}"
        )

    return (
        observed_value,
        "Aplicado y verificado mediante GET /server",
    )


def apply_default_gamemode(desired_value):
    if desired_value not in ALLOWED_DEFAULT_GAMEMODES:
        raise ValueError(
            "default_gamemode no permitido: "
            f"{desired_value!r}"
        )

    gateway_request(
        "POST",
        "/server/default-gamemode",
        {"value": desired_value},
    )

    return (
        desired_value,
        "Aplicado mediante reconocimiento HTTP del Gateway",
    )


def reconcile_server_setting(row):
    setting_key = str(row["setting_key"]).strip()
    desired_value = normalize_setting_value(
        row["desired_value"]
    )

    if setting_key == "pvp":
        message = (
            "No soportado por el Gateway: "
            "sin operación RCON estándar"
        )

        if DRY_RUN:
            log(
                "server-setting "
                f"key={setting_key} "
                f"desired={desired_value} "
                "action=would_mark_unsupported "
                "dry_run=True"
            )
            return

        update_setting_unsupported(
            setting_key,
            message,
        )

        log(
            "server-setting "
            f"key={setting_key} "
            f"desired={desired_value} "
            "result=unsupported"
        )
        return

    if DRY_RUN:
        if setting_key == "difficulty":
            if desired_value not in ALLOWED_DIFFICULTIES:
                raise ValueError(
                    "difficulty no permitida: "
                    f"{desired_value!r}"
                )

        elif setting_key == "default_gamemode":
            if (
                desired_value
                not in ALLOWED_DEFAULT_GAMEMODES
            ):
                raise ValueError(
                    "default_gamemode no permitido: "
                    f"{desired_value!r}"
                )

        else:
            raise ValueError(
                f"setting_key no soportada: {setting_key}"
            )

        log(
            "server-setting "
            f"key={setting_key} "
            f"desired={desired_value} "
            "action=would_apply "
            "dry_run=True"
        )
        return

    update_setting_applying(
        setting_key,
        f"Aplicando {setting_key}={desired_value}",
    )

    if setting_key == "difficulty":
        applied_value, message = apply_difficulty(
            desired_value
        )

    elif setting_key == "default_gamemode":
        applied_value, message = (
            apply_default_gamemode(
                desired_value
            )
        )

    else:
        raise ValueError(
            f"setting_key no soportada: {setting_key}"
        )

    update_setting_synced(
        setting_key,
        applied_value,
        message,
    )

    log(
        "server-setting "
        f"key={setting_key} "
        f"desired={desired_value} "
        f"applied={applied_value} "
        "result=synced"
    )


def reconcile_server_settings_once():
    rows = server_setting_rows()
    errors = []

    log(f"server-settings rows={len(rows)}")

    for row in rows:
        setting_key = str(row["setting_key"])

        try:
            reconcile_server_setting(row)

        except Exception as exc:
            message = clean_message(exc)
            errors.append(
                f"setting_key={setting_key}: {message}"
            )

            log(
                "server-setting "
                f"key={setting_key} "
                f"desired={row['desired_value']} "
                f"result=error "
                f"error={message}"
            )

            if not DRY_RUN:
                try:
                    update_setting_error(
                        setting_key,
                        message,
                    )
                except Exception as db_error:
                    log(
                        "server-setting "
                        f"key={setting_key} "
                        "database_error="
                        f"{clean_message(db_error)}"
                    )

    return len(rows), errors


def cycle():
    user_count, user_errors = reconcile_users_once()

    settings_count, settings_errors = (
        reconcile_server_settings_once()
    )

    errors = user_errors + settings_errors

    write_heartbeat(
        "ok" if not errors else "degraded",
        rows_count=user_count,
        server_settings_rows=settings_count,
        error=(
            " | ".join(errors)
            if errors
            else None
        ),
    )


def main():
    log(
        f"starting version={VERSION} "
        f"poll={POLL_SECONDS}s "
        f"dry_run={DRY_RUN} "
        f"gateway={GATEWAY_URL}"
    )

    while True:
        try:
            cycle()

        except Exception as exc:
            message = clean_message(exc)
            log(f"cycle_error={message}")

            try:
                write_heartbeat(
                    "error",
                    error=message,
                )
            except Exception as heartbeat_error:
                log(
                    "heartbeat_error="
                    f"{clean_message(heartbeat_error)}"
                )

        time.sleep(POLL_SECONDS)


if __name__ == "__main__":
    main()
