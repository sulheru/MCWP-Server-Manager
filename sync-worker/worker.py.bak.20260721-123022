def server_setting_rows():
    connection = db_connect()

    try:
        cursor = connection.cursor(dictionary=True)
        cursor.execute(
            """
            SELECT
                setting_key,
                desired_value,
                applied_value,
                sync_status,
                sync_message,
                updated_at,
                applied_at
            FROM wp_mc_server_settings
            WHERE sync_status IN (
                'pending',
                'error',
                'applying'
            )
               OR (
                    setting_key <> 'pvp'
                    AND NOT (
                        desired_value <=> applied_value
                    )
               )
            ORDER BY setting_key
            """
        )
        return cursor.fetchall()
    finally:
        connection.close()


def update_setting_applying(setting_key, message):
    connection = db_connect()

    try:
        cursor = connection.cursor()
        cursor.execute(
            """
            UPDATE wp_mc_server_settings
            SET
                sync_status = 'applying',
                sync_message = %s
            WHERE setting_key = %s
            """,
            (
                clean_message(message),
                setting_key,
            ),
        )
        connection.commit()
    finally:
        connection.close()


def update_setting_synced(
    setting_key,
    applied_value,
    message,
):
    connection = db_connect()

    try:
        cursor = connection.cursor()
        cursor.execute(
            """
            UPDATE wp_mc_server_settings
            SET
                applied_value = %s,
                sync_status = 'synced',
                sync_message = %s,
                applied_at = NOW()
            WHERE setting_key = %s
            """,
            (
                applied_value,
                clean_message(message),
                setting_key,
            ),
        )
        connection.commit()
    finally:
        connection.close()


